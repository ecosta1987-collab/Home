Options -Indexes
DirectoryIndex index.php index.html
RewriteEngine On

# Non esporre file e cartelle server-side.
RewriteRule ^(?:lib|database)/ - [F,L]
<FilesMatch "^(?:config(?:\.example)?\.php|.*\.sql)$">
  Require all denied
</FilesMatch>

# Impedisce di bypassare i wrapper PHP aprendo direttamente i vecchi index.html.
RewriteRule ^index\.html$ / [R=302,L,NC]
RewriteRule ^(Compiti|CompitiVacanze|Lettura|LetturaAvventura|Operazioni|Scala|Thrivers)/index\.html$ /$1/ [R=302,L,NC]
